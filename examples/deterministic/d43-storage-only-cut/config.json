{
  "$schema": "https://raw.githubusercontent.com/cobre-rs/cobre/refs/heads/main/schemas/config.schema.json",
  "training": {
    "forward_passes": 1,
    "stopping_rules": [
      {
        "type": "iteration_limit",
        "limit": 100
      },
      {
        "type": "bound_stalling",
        "iterations": 5,
        "tolerance": 1e-9
      }
    ]
  },
  "simulation": {
    "enabled": false,
    "num_scenarios": 1
  },
  "modeling": {
    "inflow_non_negativity": {
      "method": "truncation"
    }
  },
  "estimation": {
    "max_order": 2,
    "order_selection": "pacf",
    "min_observations_per_season": 20
  }
}
